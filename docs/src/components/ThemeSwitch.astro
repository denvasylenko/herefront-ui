---
// One sample on the real tokens.css: pick a theme and a scheme with segmented controls, the same markup repaints.
---
<div class="ts not-content">
  <div class="ts-bar">
    <hf-segmented aria-label="Theme" value="dashboard" data-t><option value="dashboard">dashboard</option><option value="herefront">herefront</option></hf-segmented>
    <hf-segmented aria-label="Appearance" value="light" data-s><option value="light">Light</option><option value="dark">Dark</option></hf-segmented>
  </div>
  <div class="ts-stage" data-hf-theme="dashboard" data-hf-scheme="light" data-stage>
    <div class="ts-card">
      <span class="ts-k">Today</span>
      <span class="ts-n">128 <em>↑ 12%</em></span>
      <div class="ts-acts"><hf-button variant="filled">Publish</hf-button><hf-button>Preview</hf-button></div>
    </div>
    <hf-list header="Site" style="width:min(320px,100%);margin:0">
      <hf-row title="Online booking"><hf-toggle checked aria-label="Online booking"></hf-toggle></hf-row>
      <hf-row title="Language" value="Italiano" nav></hf-row>
    </hf-list>
  </div>
  <pre class="ts-code"><code data-code>&lt;div data-hf-theme="dashboard" data-hf-scheme="light"&gt;</code></pre>
</div>
<style>
  .ts { margin: 1.5rem 0; border: 1px solid var(--sl-color-hairline); border-radius: 18px; overflow: hidden; }
  .ts-bar { display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between; padding: 12px 16px; border-bottom: 1px solid var(--sl-color-hairline); }
  .ts-stage { display: flex; flex-wrap: wrap; gap: 20px; align-items: flex-start; justify-content: center; padding: 28px 20px; background: var(--hf-bg); }
  .ts-card { display: grid; gap: 4px; width: min(300px, 100%); padding: 20px; border-radius: var(--hf-radius-4); background: var(--hf-panel); box-shadow: var(--hf-shadow-2); color: var(--hf-ink); }
  .ts-k { font-size: 13px; color: var(--hf-ink-2); }
  .ts-n { font-size: 34px; font-weight: 700; letter-spacing: -0.02em; }
  .ts-n em { font-style: normal; font-size: 15px; font-weight: 600; color: var(--hf-ok); }
  .ts-acts { display: flex; gap: 8px; margin-top: 10px; }
  .ts-code { margin: 0; padding: 14px 16px; border-top: 1px solid var(--sl-color-hairline); font-size: .85rem; overflow-x: auto; }
</style>
<script>
  document.querySelectorAll('.ts').forEach((box) => {
    const stage = box.querySelector('[data-stage]'), code = box.querySelector('[data-code]')
    const put = () => { code.textContent = `<div data-hf-theme="${stage.getAttribute('data-hf-theme')}" data-hf-scheme="${stage.getAttribute('data-hf-scheme')}">` }
    box.querySelector('[data-t]').addEventListener('change', (e) => { stage.setAttribute('data-hf-theme', e.detail.value); put() })
    box.querySelector('[data-s]').addEventListener('change', (e) => { stage.setAttribute('data-hf-scheme', e.detail.value); put() })
  })
</script>
