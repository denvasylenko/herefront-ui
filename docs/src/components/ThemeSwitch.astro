---
// A live sample on the real tokens.css: pick a theme and a scheme, the same markup repaints. One attribute is the whole switch.
---
<div class="hf-switch">
  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px">
    <button type="button" data-t="dashboard" aria-pressed="true">dashboard</button>
    <button type="button" data-t="herefront" aria-pressed="false">herefront</button>
    <button type="button" data-s="light" aria-pressed="true">light</button>
    <button type="button" data-s="dark" aria-pressed="false">dark</button>
  </div>
  <div class="hf-stage" data-hf-theme="dashboard" data-hf-scheme="light" data-stage>
    <div style="background:var(--hf-panel);border-radius:var(--hf-radius-4);padding:20px;box-shadow:var(--hf-shadow-2);max-width:360px">
      <p style="margin:0;color:var(--hf-ink-2);font-size:13px">Today</p>
      <p style="margin:4px 0 14px;font-size:34px;font-weight:700;color:var(--hf-ink)">128 <span style="font-size:15px;color:var(--hf-ok)">↑ 12%</span></p>
      <button style="border:0;border-radius:var(--hf-radius-pill);background:var(--hf-accent);color:var(--hf-accent-ink);padding:10px 18px;font:600 15px/1 inherit">Publish</button>
      <button style="border:0;border-radius:var(--hf-radius-pill);background:var(--hf-fill);color:var(--hf-ink);padding:10px 18px;font:600 15px/1 inherit;margin-left:6px">Preview</button>
    </div>
  </div>
  <p style="font-size:.85rem;opacity:.75">Markup: <code data-code>&lt;div data-hf-theme="dashboard" data-hf-scheme="light"&gt;</code></p>
</div>
<style>
  .hf-switch button[data-t], .hf-switch button[data-s] { border: 1px solid var(--sl-color-gray-5); background: transparent; color: var(--sl-color-text); border-radius: 999px; padding: 6px 14px; cursor: pointer; font: inherit; }
  .hf-switch button[aria-pressed="true"] { background: var(--sl-color-accent); color: #fff; border-color: transparent; }
</style>
<script>
  document.querySelectorAll('.hf-switch').forEach((box) => {
    const stage = box.querySelector('[data-stage]'), code = box.querySelector('[data-code]');
    box.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => {
      const attr = b.dataset.t ? 'data-hf-theme' : 'data-hf-scheme', val = b.dataset.t || b.dataset.s;
      stage.setAttribute(attr, val);
      box.querySelectorAll(b.dataset.t ? '[data-t]' : '[data-s]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      code.textContent = `<div data-hf-theme="${stage.getAttribute('data-hf-theme')}" data-hf-scheme="${stage.getAttribute('data-hf-scheme')}">`;
    }));
  });
</script>
