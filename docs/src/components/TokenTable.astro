---
// Every token, read from ../dist/tokens.json at build time: theme colours with a live swatch in light and dark,
// measures with their value. A search field filters the rows as you type.
import data from '../../../dist/tokens.json';
const themes = Object.entries(data.themes);
const isColor = (v) => /^(#|rgba?\(|linear-gradient)/.test(String(v));
const base = Object.entries(data.base);
---
<input class="hf-find" type="search" placeholder="Find a token: accent, radius, glass…" aria-label="Find a token" data-hf-find />
{themes.map(([id, t]) => {
  const keys = [...new Set([...Object.keys(t.light), ...Object.keys(t.dark)])];
  return (
    <section>
      <h2 id={`theme-${id}`}>Theme <code>{id}</code></h2>
      <table class="hf-tok" data-hf-rows>
        <thead><tr><th>Token</th><th>Light</th>{t.scheme !== 'light' && <th>Dark</th>}</tr></thead>
        <tbody>{keys.map((k) => (
          <tr data-name={k}>
            <td><code>--hf-{k}</code></td>
            {[t.light[k], ...(t.scheme !== 'light' ? [t.dark[k]] : [])].map((v) => (
              <td>{v === undefined ? <span>—</span> : <span style="display:flex;gap:10px;align-items:center">
                {isColor(v) && <span class="hf-swatch" style={`background:${v}`} />}
                {/^0 |shadow/.test(k) && <span class="hf-swatch" style={`background:#fff;box-shadow:${v}`} />}
                <code>{v}</code></span>}</td>
            ))}
          </tr>))}
        </tbody>
      </table>
    </section>
  );
})}
<h2 id="measures">Measures (every theme)</h2>
<table class="hf-tok" data-hf-rows>
  <thead><tr><th>Token</th><th>Value</th></tr></thead>
  <tbody>{base.map(([k, v]) => (
    <tr data-name={k}><td><code>--hf-{k}</code></td><td><span style="display:flex;gap:10px;align-items:center">
      {/^radius/.test(k) && <span class="hf-swatch" style={`border-radius:${v};background:var(--sl-color-accent-low);box-shadow:inset 0 0 0 1.5px var(--sl-color-accent)`} />}
      {/^space/.test(k) && <span style={`display:inline-block;height:12px;width:${v};background:var(--sl-color-accent)`} />}
      <code>{v}</code></span></td></tr>))}
  </tbody>
</table>
<script>
  const find = document.querySelector('[data-hf-find]');
  find?.addEventListener('input', () => {
    const q = find.value.trim().toLowerCase();
    document.querySelectorAll('[data-hf-rows] tr[data-name]').forEach((tr) => { tr.hidden = !!q && !tr.dataset.name.includes(q); });
  });
</script>
