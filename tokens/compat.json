{
  "$description": "Old variable names the products read today → the token that now holds the value. Emitted as aliases (--bg: var(--hf-bg)) in dist/compat.css while the products move over; delete an entry when grep finds no reader. A theme alias is emitted only where the theme has that token, or only for the themes listed.",
  "theme": {
    "--bg": "bg",
    "--panel": "panel",
    "--panel-2": "panel-2",
    "--ink": "ink",
    "--muted": "ink-2",
    "--faint": "ink-3",
    "--line": "line",
    "--line-strong": "line-strong",
    "--fill": "fill",
    "--fill-2": "fill-2",
    "--hover": "hover",
    "--seg-on": "seg-on",
    "--seg-on-ink": "seg-on-ink",
    "--seg-thumb": "seg-thumb",
    "--accent": "accent",
    "--accent-ink": "accent-ink",
    "--accent-soft": "accent-soft",
    "--good": "ok",
    "--good-soft": "ok-soft",
    "--warn": "warn",
    "--warn-soft": "warn-soft",
    "--bad": "danger",
    "--bad-soft": "danger-soft",
    "--bar-bg": "bar-bg",
    "--scrim": "scrim",
    "--shadow-1": "shadow-1",
    "--shadow-2": "shadow-2",
    "--shadow-3": "shadow-3",
    "--viz-1": "viz-1",
    "--viz-1-soft": "viz-1-soft",
    "--viz-o1": "viz-o1",
    "--viz-o2": "viz-o2",
    "--viz-o3": "viz-o3",
    "--viz-o4": "viz-o4",
    "--font": { "token": "font-sans", "themes": ["herefront"] },
    "--ease": { "token": "ease-page", "themes": ["herefront"] },
    "--grad": "brand-grad"
  },
  "base": {
    "--radius-sm": "radius-2",
    "--radius": "radius-3",
    "--radius-lg": "radius-4"
  }
}
