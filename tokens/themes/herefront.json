{
  "$description": "Herefront light palette: the client cabinet (frontend/cabinet), herefront.com and the studio. Light only, also when the system is dark (owner decision: the cabinet has no dark theme). Turn on with data-hf-theme=\"herefront\".",
  "$scheme": "light",
  "light": {
    "bg": "#f5f5f7",
    "panel": "#ffffff",
    "seg-thumb": "#ffffff",
    "panel-2": "#fbfbfd",
    "ink": "#1d1d1f",
    "ink-2": "#6e6e73",
    "ink-3": "#86868b",
    "line": "rgba(0, 0, 0, 0.08)",
    "line-strong": "#d2d2d7",
    "fill": "#f2f2f5",
    "fill-2": "#e8e8ed",
    "hover": "rgba(0, 0, 0, 0.04)",
    "seg-on": "#ffffff",
    "seg-on-ink": "#1d1d1f",
    "accent": "#0071e3",
    "accent-ink": "#ffffff",
    "accent-soft": "#e8f3fd",
    "ok": "#248a3d",
    "ok-soft": "#f0f8f2",
    "warn": "#b25000",
    "warn-soft": "rgba(255, 149, 0, 0.14)",
    "danger": "#ff3b30",
    "danger-soft": "rgba(255, 59, 48, 0.1)",
    "bar-bg": "rgba(251, 251, 253, 0.86)",
    "scrim": "rgba(0, 0, 0, 0.18)",
    "shadow-1": "0 1px 2px rgba(0, 0, 0, 0.04), 0 0 0 1px rgba(0, 0, 0, 0.04)",
    "shadow-2": "0 12px 40px -18px rgba(0, 0, 0, 0.25), 0 1px 2px rgba(0, 0, 0, 0.04)",
    "shadow-3": "-20px 0 60px -20px rgba(0, 0, 0, 0.3)",
    "viz-1": "#2a78d6",
    "viz-1-soft": "#86b6ef",
    "viz-o1": "#86b6ef",
    "viz-o2": "#5598e7",
    "viz-o3": "#256abf",
    "viz-o4": "#104281",
    "font-sans": "-apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"SF Pro Text\", \"Inter\", \"Helvetica Neue\", Arial, sans-serif",
    "ease-page": "cubic-bezier(.28, .11, .32, 1)",
    "brand-grad": "linear-gradient(135deg, #ff7a45 0%, #f0466e 50%, #a855f7 100%)"
  }
}
